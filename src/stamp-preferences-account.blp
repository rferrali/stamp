using Gtk 4.0;
using Adw 1;

template $StampPreferencesAccount: Adw.NavigationPage {
  title: _("Account");

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle window_title {
        title: _("Account");
      };
    }

    content: Adw.PreferencesPage page {
      Adw.PreferencesGroup {
        title: _("Composing");

        Adw.ComboRow default_signature {
          title: _("Default Signature");
        }
      }

      Adw.PreferencesGroup out_of_office_group {
        visible: false;

        Adw.ActionRow {
          title: _("Out of Office");
          subtitle: _("Automatically reply to incoming messages while you are away");
          activatable: true;
          activated => $on_out_of_office_activated();

          [suffix]
          Image {
            icon-name: "go-next-symbolic";
          }
        }
      }

      Adw.PreferencesGroup badge_color_group {
        title: _("Badge Color");
        description: _("Color for the account badge in the combined inbox");

        header-suffix: Button reset_badge_color_button {
          label: _("Reset to Automatic");
          valign: center;
          tooltip-text: _("Reset to automatically generated color");

          styles [
            "flat",
          ]
        };

        Adw.PreferencesRow {
          accessible-role: group;
          activatable: false;
          focusable: false;

          FlowBox badge_color_box {
            selection-mode: none;
            homogeneous: true;
            max-children-per-line: 7;
            column-spacing: 8;
            row-spacing: 8;
            margin-top: 12;
            margin-bottom: 12;
            halign: center;

            styles [
              "badge-color-box",
            ]
          }
        }
      }

      Adw.PreferencesGroup alias_group {
        title: _("Aliases");
        description: _("Add different names or email addresses to your account");

        accessibility {
          label: _("Alias Preferences");
        }
      }

      Adw.PreferencesGroup {
        Adw.ButtonRow add_alias {
          title: _("Add Alias");
          activated => $on_add_alias_clicked();
        }
      }

      Adw.PreferencesGroup {
        title: _("Notifications");

        Adw.ComboRow notification_mode {
          title: _("Folder Notifications");
          subtitle: _("Select which folders trigger notifications");

          accessibility {
            label: _("Notification Mode");
          }
        }
      }

      Adw.PreferencesGroup {
        title: _("Security");

        Adw.ComboRow pgp_key {
          title: _("PGP Key");
          subtitle: _("Select the PGP key to use for signing and encryption");
        }

        Adw.ComboRow smime_sign_cert {
          title: _("S/MIME Signing Certificate");
          subtitle: _("Select the certificate to use for S/MIME signing");
        }

        Adw.ComboRow smime_encrypt_cert {
          title: _("S/MIME Encryption Certificate");
          subtitle: _("Select the certificate to use for S/MIME encryption");
        }
      }

      Adw.PreferencesGroup notification_folders_group {
        title: _("Custom Folders");
        description: _("Enable notifications for selected folders");
        visible: false;
      }
    };
  };
}
