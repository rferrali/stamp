using Gtk 4.0;
using Adw 1;

template $StampMessageListItem: ListBoxRow {
  activatable: false;

  styles [
    "card",
  ]

  child: Box {
    orientation: vertical;

    $StampMessageHeader header {
      GestureClick {
        released => $on_header_clicked();
      }

      styles [
        "message-list-item-clickable",
      ]

      hexpand: true;
    }

    Revealer secondary_revealer {
      visible: false;

      child: Box {
        orientation: vertical;

        Adw.Banner error_banner {
          revealed: false;

          styles [
            "message-header-banner",
          ]
        }

        Adw.Banner blocked_images_banner {
          title: _("This message contains remote images");
          button-label: _("Show");
          button-clicked => $on_show_images();
          revealed: false;

          styles [
            "message-header-banner",
          ]
        }

        Adw.Banner disposition_banner {
          button-label: _("Send");
          button-clicked => $on_send_disposition();
          revealed: false;

          styles [
            "message-header-banner",
          ]
        }

        Adw.Banner signature_banner {
          button-label: _("Show");
          button-clicked => $on_show_signatures();
          revealed: false;

          styles [
            "message-header-banner",
          ]
        }

        Adw.Banner encryption_banner {
          revealed: false;

          styles [
            "message-header-banner",
          ]
        }

        Box meeting_card {
          visible: false;
          orientation: vertical;
          spacing: 6;

          styles [
            "meeting-section",
          ]

          Box meeting_details {
            orientation: vertical;
          }

          Button meeting_remove {
            visible: false;
            label: _("Remove from Calendar");
            halign: start;
            clicked => $on_remove_meeting();

            styles [
              "destructive-action",
            ]
          }

          Label meeting_removed_label {
            visible: false;
            label: _("Removed from calendar");
            xalign: 0;
            wrap: true;

            styles [
              "dim-label",
            ]
          }

          Button meeting_rsvp {
            label: _("Respond…");
            halign: start;
            clicked => $on_rsvp();

            styles [
              "suggested-action",
            ]
          }
        }

        Box {
          orientation: vertical;

          Adw.WrapBox attachment_flow_box {
            visible: false;
          }

          Box {
            orientation: horizontal;
            margin-bottom: 6;
            margin-start: 6;
            margin-end: 6;

            Label attachment_info_label {
              visible: false;
              halign: start;
              hexpand: true;
            }

            Button save_all_button {
              label: _("Save All…");
              visible: false;
              halign: end;
            }
          }
        }

        Box web_view_box {
          orientation: vertical;
        }
      };
    }
  };
}
