using Gtk 4.0;
using Adw 1;

template $StampConversationRow: Box {
  orientation: vertical;

  Overlay swipe_overlay {
    vexpand: true;
    overflow: hidden;

    [overlay]
    ScrolledWindow left_action {
      halign: start;
      visible: false;
      opacity: 0;
      hscrollbar-policy: external;
      vscrollbar-policy: never;
      can-target: false;
      overflow: hidden;

      styles [
        "swipe-action",
        "accent",
      ]

      child: Box {
        orientation: vertical;
        valign: center;
        hexpand: true;
        spacing: 6;
        margin-start: 8;
        margin-end: 8;

        Image left_action_image {
          icon-name: "mail-read-symbolic";
          pixel-size: 24;
        }

        Label left_action_label {
          label: _("Mark Read");
          ellipsize: end;
          max-width-chars: 12;
          justify: center;
          opacity: 0;

          styles [
            "caption-heading",
          ]
        }
      };
    }

    [overlay]
    ScrolledWindow right_action {
      halign: end;
      visible: false;
      opacity: 0;
      hscrollbar-policy: external;
      vscrollbar-policy: never;
      can-target: false;
      overflow: hidden;

      styles [
        "swipe-action",
        "error",
      ]

      child: Box {
        orientation: vertical;
        valign: center;
        hexpand: true;
        spacing: 6;
        margin-start: 8;
        margin-end: 8;

        Image right_action_image {
          icon-name: "user-trash-symbolic";
          pixel-size: 24;
        }

        Label right_action_label {
          label: _("Trash");
          ellipsize: end;
          max-width-chars: 12;
          justify: center;
          opacity: 0;

          styles [
            "caption-heading",
          ]
        }
      };
    }

    child: Grid row {
      hexpand: true;
      vexpand: true;
      halign: start;

      styles [
        "conversation-row",
      ]

      Stack stack {
        Adw.Avatar avatar {
          valign: start;
          size: 32;
          show-initials: true;
        }

        CheckButton check_button {
          valign: start;
          toggled => $on_check_button_toggled();
          can-focus: false;

          styles [
            "selection-mode",
          ]
        }

        layout {
          row: 0;
          column: 0;
          row-span: 3;
        }
      }

      Box {
        layout {
          column: 1;
          row: 0;
        }

        Inscription participants {
          hexpand: true;
          xalign: 0;
          text-overflow: ellipsize_end;
          nat-chars: 999;
        }

        Label date {
          xalign: 1;
          ellipsize: end;

          styles [
            "caption",
          ]
        }
      }

      Box {
        layout {
          column: 1;
          row: 1;
        }

        Inscription topic {
          hexpand: true;
          xalign: 0;
          text-overflow: ellipsize_end;
        }

        Label counter {
          styles [
            "counter",
            "numeric",
            "long",
          ]

          valign: center;
        }
      }

      Box {
        layout {
          column: 1;
          row: 2;
        }

        Label account_pill {
          visible: false;

          styles [
            "account-pill",
          ]
        }

        FlowBox labels {
          selection-mode: none;
          visible: false;
        }

        Inscription body {
          hexpand: true;
          xalign: 0;
          valign: center;
          text-overflow: ellipsize_end;

          styles [
            "caption",
          ]
        }

        Image reply_icon {
          accessibility {
            label: _("Replied to Mail");
          }

          icon-name: "mail-replied-symbolic";
          visible: false;
        }

        Image forwarded_icon {
          accessibility {
            label: _("Forwarded Mail");
          }

          icon-name: "mail-forward-symbolic";
          visible: false;
        }

        Image calendar_icon {
          accessibility {
            label: _("Move to Trash");
          }

          icon-name: "x-office-calendar-symbolic";
          visible: false;
        }

        Image attachment_icon {
          accessibility {
            label: _("Mail Attachment");
          }

          icon-name: "mail-attachment-symbolic";
          visible: false;
        }

        Image flagged_icon {
          accessibility {
            label: _("Flagged Mail");
          }

          icon-name: "non-starred-symbolic";
        }
      }
    };

    GestureDrag {
      touch-only: true;
      drag-update => $on_drag_update();
      drag-end => $on_drag_end();
      cancel => $on_drag_cancel();
      propagation-phase: capture;
    }
  }
}
