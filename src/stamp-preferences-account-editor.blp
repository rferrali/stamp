using Gtk 4.0;
using Adw 1;

template $StampPreferencesAccountEditor: Adw.NavigationPage {
  title: _("Alias");

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle editor_window_title {
        title: _("Alias");
      };
    }

    content: Adw.Clamp {
      maximum-size: 600;

      child: Box {
        orientation: vertical;
        spacing: 12;
        margin-top: 12;
        margin-bottom: 12;
        margin-start: 12;
        margin-end: 12;

        Adw.PreferencesGroup {
          title: _("Alias");

          Adw.EntryRow mail_row {
            title: _("Email");
            changed => $on_entry_changed();
          }

          Adw.EntryRow name_row {
            title: _("Name");
          }
        }

        Adw.PreferencesGroup {
          Adw.ButtonRow save {
            title: _("Save");
            sensitive: false;
            activated => $on_save_clicked();

            styles [
              "suggested-action",
            ]
          }
        }

        Adw.PreferencesGroup {
          Adw.ButtonRow remove {
            title: _("Remove");
            visible: false;
            activated => $on_remove_clicked();

            styles [
              "destructive-action",
            ]
          }
        }
      };
    };
  };
}
