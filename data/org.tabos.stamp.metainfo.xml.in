<component type="desktop-application">
  <id>org.tabos.stamp</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Stamp</name>
  <summary>Mails and more</summary>
  <description>
    <p>Stamp is a modern personal information management application that provides integrated mail and contacts functionality, designed for the GNOME desktop.</p>
    <p>Built on the Evolution Data Server stack, Stamp supports a wide range of industry standard data formats and network protocols for information exchange, with an emphasis on standards compliance and security. Messages can be signed and encrypted using OpenPGP and S/MIME, and Stamp supports Brand Indicators for Message Identification (BIMI) as well as one-click unsubscribe from mailing lists.</p>
    <p>Manage your email accounts, stay on top of your conversations and keep your address books in sync — all in a clean, focused and privacy-friendly interface.</p>
  </description>

  <!-- These allow us to be found in GNOME Software, as it ignores the description for searching: -->
  <keywords>
    <keyword>PIM</keyword>
    <keyword>Personal Information Manager</keyword>
    <keyword>groupware</keyword>
    <keyword>emails</keyword>
    <keyword>email client</keyword>
    <keyword translate="no">IMAP</keyword>
    <keyword>contacts</keyword>
    <keyword>addressbook</keyword>
    <keyword translate="no">Evolution Data Server</keyword>
    <keyword translate="no">GNOME Online Accounts</keyword>
  </keywords>

